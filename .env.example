# ---- Discord Webhook Manager for CMK ----
# Copy to .env and fill in. deploy/install.sh generates this automatically.

# 32 bytes hex (64 chars). Used to encrypt webhook URLs and sign session cookies.
# Generate: openssl rand -hex 32
# CAUTION: changing this makes every stored webhook URL undecryptable.
APP_SECRET=

# ---- Discord login (primary authentication) ----
# From https://discord.com/developers/applications -> your app -> OAuth2.
# Register this exact Redirect URI there:
#   ${PUBLIC_BASE_URL}/auth/discord/callback
# Without both values, Discord login is unavailable and only the emergency
# password below works. deploy/set-discord-auth.sh fills these in for you.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email of the first admin, seeded on first boot when no admins exist yet.
# Must match the *verified* email on that person's Discord account.
BOOTSTRAP_ADMIN_EMAIL=

# Emergency password, used only for the fallback login on the sign-in page.
# Read once when no password is set in the DB yet. Keep it somewhere safe: it is
# the way back in if the Discord app is misconfigured.
ADMIN_PASSWORD=

# Bind address / port. Keep 127.0.0.1 — public access goes through Cloudflare Tunnel.
HOST=127.0.0.1
PORT=8080

# Public base URL, used in alert notifications so links are clickable.
PUBLIC_BASE_URL=https://webhook-manager-cmk.uslog.tech

# SQLite file path.
DATABASE_PATH=./data/dwm.db

# Display timezone for the UI and for cron schedules.
TZ_DISPLAY=Asia/Tokyo

# Scheduler
SCHEDULER_TICK_MS=5000
SCHEDULER_BATCH=10
# Jobs whose scheduled time was missed by more than this are marked failed
# instead of firing late (seconds). Default 24h.
MISFIRE_GRACE_SECONDS=86400
# Max delivery attempts before a job is terminally failed.
MAX_ATTEMPTS=5

# Session lifetime (seconds). Default 7 days.
SESSION_TTL_SECONDS=604800
# Set to 0 when serving over plain HTTP (e.g. local port-forward testing).
COOKIE_SECURE=1

# Log level: debug | info | warn | error
LOG_LEVEL=info
